# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl
.terraformrc
terraform.rc

# Sensitive values — env tfvars are committed intentionally; local secrets are not
*.auto.tfvars
secrets.tfvars
*.pem
*.key
*.pfx
.env
.env.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / tooling caches
node_modules/

# Helm
charts/**/charts/
charts/**/*.tgz

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store

# Scanner outputs (generated locally, never committed)
trivy-results.*
checkov-report.*
gitleaks-report.*
sonar-report.*
